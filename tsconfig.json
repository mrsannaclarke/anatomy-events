{
  "compilerOptions": {
    "allowJs": true,
    "baseUrl": ".",
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "target": "ES2022",
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": ["src/**/*", "project.json", "docs/app-rules.json"]
}
